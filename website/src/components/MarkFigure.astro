---
// Inline, hand-traced version of mark.png: a faceted seed crystal growing
// through a stem into a graph of nodes. Two modes share one drawing:
//   hero  — assembles once on page load (CSS keyframes)
//   story — advances by scroll stage (data-stage 0/1/2, set by motion.js)
// Default stage is "2" (fully drawn) so the figure is complete without JS
// and under prefers-reduced-motion.
const { mode = 'hero' } = Astro.props;

const nodes = [
  { x: 210, y: 198, r: 8, base: true, alt: true },
  { x: 150, y: 150, r: 5.5 },
  { x: 248, y: 142, r: 5.5 },
  { x: 118, y: 92, r: 5 },
  { x: 196, y: 72, r: 6.5, alt: true },
  { x: 278, y: 84, r: 5 },
  { x: 158, y: 34, r: 4 },
  { x: 240, y: 28, r: 4.5, alt: true },
  { x: 312, y: 138, r: 4 },
  { x: 94, y: 160, r: 4, alt: true },
];

const edges = [
  [0, 1], [0, 2], [1, 4], [1, 3], [2, 4], [2, 5], [3, 6], [4, 6],
  [4, 7], [5, 7], [5, 8], [2, 8], [1, 9], [3, 9],
];

// Seed, traced from frontend/src-tauri/icons/app-icon.png: an irregular
// angular gem with a deep Z-shaped cleft in its top edge — the stem grows
// out of the split. One solid silhouette; the facets are dark seam lines
// (the page background showing through as cuts), meeting at a lower hub H
// and the cleft apex, like the source mark.
const seedOutline =
  'M120 330 L185 295 L232 308 L196 382 L252 330 L285 338 L292 398 ' +
  'L255 452 L165 460 L108 420 L95 365 Z';

const H = [175, 408];
const apex = [196, 382];
const seams = [
  [[120, 330], H],
  [[185, 295], H],
  [[95, 365], H],
  [[108, 420], H],
  [H, [165, 460]],
  [H, [255, 452]],
  [H, apex],
  [apex, [255, 452]],
  [[252, 330], [255, 452]],
];
---

<svg
  class:list={['mark-svg', mode === 'hero' ? 'mark-hero' : 'mark-story']}
  data-mark-story={mode === 'story' ? '' : undefined}
  data-stage={mode === 'story' ? '2' : undefined}
  viewBox="0 0 400 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g class="m-seed">
    <path class="m-seed-fill" d={seedOutline} fill="var(--color-seed)" />
    {
      seams.map(([a, b], i) => (
        <line
          class="m-seam"
          style={`--i:${i}`}
          x1={a[0]}
          y1={a[1]}
          x2={b[0]}
          y2={b[1]}
          pathLength="1"
          stroke="var(--color-ink)"
          stroke-width="4"
        />
      ))
    }
  </g>

  <path
    class="m-stem"
    d="M205 375 C215 355 238 342 240 318 C242 298 222 290 216 262 C212 240 210 220 210 198"
    pathLength="1"
    stroke="var(--color-seed)"
    stroke-width="4"
    stroke-linecap="round"
  />

  <g class="m-edges">
    {
      edges.map(([a, b], i) => (
        <line
          class="m-edge"
          style={`--i:${i}`}
          x1={nodes[a].x}
          y1={nodes[a].y}
          x2={nodes[b].x}
          y2={nodes[b].y}
          pathLength="1"
          stroke="var(--color-node)"
          stroke-opacity="0.55"
          stroke-width="1.5"
        />
      ))
    }
  </g>

  <g class="m-nodes">
    {
      nodes.map((n, i) => (
        <circle
          class:list={['m-node', n.base && 'm-node--base']}
          style={`--i:${i}`}
          cx={n.x}
          cy={n.y}
          r={n.r}
          fill={n.alt ? 'var(--color-nodealt)' : 'var(--color-node)'}
        />
      ))
    }
  </g>
</svg>
