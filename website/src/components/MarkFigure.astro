---
// Inline version of the Grafyn mark: a faceted seed crystal split open by a
// sprouting stem that grows into a graph of nodes. Two modes share one
// drawing:
//   hero  — assembles once on page load (CSS keyframes)
//   story — advances by scroll stage (data-stage 0/1/2, set by motion.js)
// Default stage is "2" (fully drawn) so the figure is complete without JS
// and under prefers-reduced-motion.
//
// The seed geometry is traced from the real app icon
// (frontend/src-tauri/icons/app-icon.png): the gem is a low-poly mesh of
// separate facet polygons, and the fracture is the negative space between
// them — the background showing through — exactly as in the icon. FACETS
// holds the traced polygons in icon pixel coordinates (1024×1024 source);
// they are scaled into the viewBox below. Re-trace rather than hand-edit.
const { mode = 'hero' } = Astro.props;

// Traced facet polygons, icon coords (bbox x 235–553, y 536–859).
const FACETS = [
  [[542, 536], [547, 539], [536, 573], [502, 620], [433, 671], [497, 592], [528, 570]],
  [[387, 547], [478, 557], [304, 655]],
  [[370, 552], [291, 656], [291, 596]],
  [[474, 570], [367, 726], [295, 671]],
  [[281, 609], [282, 667], [241, 683]],
  [[553, 636], [553, 727], [444, 795]],
  [[540, 637], [426, 803], [375, 733]],
  [[279, 678], [245, 805], [235, 696]],
  [[289, 678], [360, 733], [252, 812]],
  [[367, 739], [417, 808], [261, 818]],
  [[544, 743], [494, 817], [441, 809]],
  [[410, 817], [417, 818], [389, 859], [265, 827]],
  [[429, 817], [480, 824], [403, 855]],
];

// Map icon coords into the 400×480 viewBox: gem 200 wide, centred at
// x=180, bottom edge at y=468.
const S = 200 / 318;
const mapPt = ([x, y]) => [180 + (x - 394) * S, 468 - (859 - y) * S];

const facets = FACETS
  .map((poly) => {
    const pts = poly.map(mapPt);
    const maxY = Math.max(...pts.map((p) => p[1]));
    return { d: 'M' + pts.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join(' L') + ' Z', maxY };
  })
  // bottom-up assembly order in hero mode
  .sort((a, b) => b.maxY - a.maxY);

// Stem: rises out of the fracture channel (deep point of the crack, up
// through the mouth at the gem's top-right), then an S-bend to the base
// node at (210, 198).
const stemPath = 'M 204 350 C 228 314 248 290 264 268 C 284 240 244 216 210 198';

const nodes = [
  { x: 210, y: 198, r: 8, base: true, alt: true },
  { x: 150, y: 150, r: 5.5 },
  { x: 248, y: 142, r: 5.5 },
  { x: 118, y: 92, r: 5 },
  { x: 196, y: 72, r: 6.5, alt: true },
  { x: 278, y: 84, r: 5 },
  { x: 158, y: 34, r: 4 },
  { x: 240, y: 28, r: 4.5, alt: true },
  { x: 312, y: 138, r: 4 },
  { x: 94, y: 160, r: 4, alt: true },
];

const edges = [
  [0, 1], [0, 2], [1, 4], [1, 3], [2, 4], [2, 5], [3, 6], [4, 6],
  [4, 7], [5, 7], [5, 8], [2, 8], [1, 9], [3, 9],
];
---

<svg
  class:list={['mark-svg', mode === 'hero' ? 'mark-hero' : 'mark-story']}
  data-mark-story={mode === 'story' ? '' : undefined}
  data-stage={mode === 'story' ? '2' : undefined}
  viewBox="0 0 400 480"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g class="m-seed">
    {
      facets.map((f, i) => (
        <path class="m-facet" style={`--i:${i}`} d={f.d} fill="var(--color-seed)" />
      ))
    }
  </g>

  <path
    class="m-stem"
    d={stemPath}
    pathLength="1"
    stroke="var(--color-seed)"
    stroke-width="4"
    stroke-linecap="round"
  />

  <g class="m-edges">
    {
      edges.map(([a, b], i) => (
        <line
          class="m-edge"
          style={`--i:${i}`}
          x1={nodes[a].x}
          y1={nodes[a].y}
          x2={nodes[b].x}
          y2={nodes[b].y}
          pathLength="1"
          stroke="var(--color-node)"
          stroke-opacity="0.55"
          stroke-width="1.5"
        />
      ))
    }
  </g>

  <g class="m-nodes">
    {
      nodes.map((n, i) => (
        <circle
          class:list={['m-node', n.base && 'm-node--base']}
          style={`--i:${i}`}
          cx={n.x}
          cy={n.y}
          r={n.r}
          fill={n.alt ? 'var(--color-nodealt)' : 'var(--color-node)'}
        />
      ))
    }
  </g>
</svg>
