---
import { GITHUB_RELEASES } from '../lib/paths.js';

const { compact = false } = Astro.props;
---

<div class="download-cta" data-download-cta>
  <div class={`flex flex-wrap items-center ${compact ? 'gap-3' : 'gap-4'}`}>
    <a
      class="btn-primary group"
      data-download-primary
      href={GITHUB_RELEASES}
    >
      <span data-download-label>Get Grafyn on GitHub Releases</span>
      <span class="icon-circle" aria-hidden="true">
        <i class="ph-light ph-arrow-up-right text-base"></i>
      </span>
    </a>
    {
      !compact && (
        <a class="btn-ghost" href="https://github.com/WKJBryan/Grafyn">
          View source
        </a>
      )
    }
  </div>

  <p
    class="mt-3 font-mono text-xs text-mute"
    data-download-meta
    hidden
  >
  </p>

  <p
    class="mt-2 font-mono text-xs text-mute"
    data-download-status
    hidden
    aria-live="polite"
  >
  </p>

  <details class="other-platforms mt-3 max-w-sm">
    <summary
      class="cursor-pointer text-sm text-mute transition-colors duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:text-paper"
    >
      Other platforms
    </summary>
    <ul
      class="mt-3 space-y-2 text-sm text-mute"
      data-other-platforms
    >
      <li>
        <a class="underline decoration-hairline underline-offset-4 hover:text-paper" href={GITHUB_RELEASES}>
          All releases
        </a>
      </li>
    </ul>
  </details>
</div>
