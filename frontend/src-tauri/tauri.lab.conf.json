{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grafyn Twin Eval Lab",
  "version": "0.3.0",
  "identifier": "com.grafyn.twin-eval-lab",
  "build": {
    "devUrl": "http://localhost:5173/lab.html"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Grafyn Twin Eval Lab",
        "width": 1280,
        "minWidth": 960,
        "minHeight": 720,
        "center": true,
        "visible": true,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "dmg", "deb", "appimage"]
  }
}
