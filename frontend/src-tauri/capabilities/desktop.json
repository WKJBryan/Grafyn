{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only access for the Grafyn main window",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "dialog:allow-open",
    "dialog:allow-message",
    "opener:default",
    "updater:default"
  ]
}
