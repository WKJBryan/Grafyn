{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafyn.dev/schemas/sync/envelope-v1.schema.json",
  "title": "Grafyn encrypted sync envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "vault_id",
    "device_id",
    "device_public_key",
    "operation_id",
    "nonce",
    "ciphertext",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "grafyn.sync.envelope"
    },
    "schema_version": {
      "const": 1
    },
    "vault_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "device_public_key": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "ciphertext": {
      "type": "string",
      "minLength": 23,
      "maxLength": 1466688,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-][AQgw]|[A-Za-z0-9_-]{2}[AEIMQUYcgkosw048])?$"
    },
    "signature": {
      "type": "string",
      "minLength": 86,
      "maxLength": 86,
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
